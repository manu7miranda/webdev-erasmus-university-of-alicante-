# Every environment variable the app reads, with harmless placeholder values.
# Copy to .env for local use. Real values go into Render's Environment settings or the
# repository's Codespaces secrets, never into git.

# --- Required: the app refuses to start without these ---
# PostgreSQL connection string. Locally: the Docker database from `npm run db`.
# In production: Neon dashboard -> Connect -> connection string (postgresql://...neon.tech...).
DATABASE_URL=
# Signs the session cookie. Generate one with: openssl rand -hex 32 (a different value per environment).
SESSION_SECRET=

# --- Optional ---
# Port the server listens on. Render sets it by itself.
PORT=3000
# "production" on Render: the session cookie is then only sent over https.
NODE_ENV=development
# The public address of the app, used for the Google sign-in redirect.
PUBLIC_BASE_URL=http://localhost:3000

# Sign in with Google. Create an OAuth client at console.cloud.google.com and leave it in
# "Testing" mode with yourself as a test user: that is free and needs no app verification.
# Add every address you will sign in from as an authorized redirect URI, including your
# codespace's forwarded URL and your Render URL. Google requires https off localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The model feature (event description suggestions). Free key from aistudio.google.com.
# Without it the app still works: organizers write the description by hand.
GEMINI_API_KEY=
MODEL_NAME=gemini-3.5-flash-lite

# Token the MCP server signs in with, as one member. Create it with:
# npm run mcp-token -- member@club.com   (only its hash is stored in the database)
MCP_TOKEN=
